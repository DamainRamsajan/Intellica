{
  "name": "intellica-web",
  "private": true,
  "type": "module",
  "description": "Intellica web system: shared shell (kit), company home, product site template, tools and arc42.",
  "scripts": {
    "dev": "node tools/serve.mjs site 8080",
    "dev:verichain": "node tools/serve.mjs products/verichain/site 8081",
    "dev:vericrypt": "node tools/serve.mjs products/vericrypt/site 8082",
    "dev:erp": "node tools/serve.mjs products/sovereign-erp/site 8083",
    "dev:omc": "node tools/serve.mjs products/omc/site 8084",
    "check": "node tools/check.mjs --all",
    "test": "node tools/test-markdown.mjs",
    "sync": "node tools/sync-kit.mjs && node tools/prerender.mjs",
    "scaffold": "node tools/new-product.mjs",
    "legacy": "node tools/import-legacy.mjs",
    "gate": "npm run test && npm run sync && npm run check",
    "setup": "node tools/doctor.mjs && npm install && npx playwright install --with-deps chromium",
    "test:browser": "node tools/browser-test.mjs",
    "verify": "npm run gate && npm run test:browser",
    "dev:agentseed": "node tools/serve.mjs products/agentseed/site 8085"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  },
  "version": "0.5.0"
}
